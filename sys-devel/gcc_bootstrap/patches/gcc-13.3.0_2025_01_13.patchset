From b40a5f609567dc86d5dec642064f27784c28ec53 Mon Sep 17 00:00:00 2001
From: Han Pengfei <pengphei@foxmail.com>
Date: Tue, 14 Jan 2025 11:58:28 +0800
Subject: [PATCH] add loongarch for haiku

Signed-off-by: Han Pengfei <pengphei@foxmail.com>
---
 gcc/config.gcc               | 16 +++++++++++
 gcc/config/loongarch/haiku.h | 52 ++++++++++++++++++++++++++++++++++++
 gcc/config/loongarch/t-haiku |  4 +++
 isl/config.sub               |  2 ++
 libgcc/config.host           |  9 +++++++
 mpc/build-aux/config.sub     |  1 +
 6 files changed, 84 insertions(+)
 create mode 100644 gcc/config/loongarch/haiku.h
 create mode 100644 gcc/config/loongarch/t-haiku

diff --git a/gcc/config.gcc b/gcc/config.gcc
index ed5c021..f153d967 100644
--- a/gcc/config.gcc
+++ b/gcc/config.gcc
@@ -2544,6 +2544,17 @@ loongarch*-*-linux*)
 	gcc_cv_initfini_array=yes
 	;;
 
+loongarch*-*-haiku*)
+	tm_file="elfos.h haiku.h ${tm_file} loongarch/haiku.h haiku-stdint.h"
+	tmake_file="${tmake_file} t-haiku loongarch/t-haiku"
+	gnu_ld=yes
+	gas=yes
+
+	# Force .init_array support.  The configure script cannot always
+	# automatically detect that GAS supports it, yet we require it.
+	gcc_cv_initfini_array=yes
+	;;
+
 mips*-*-netbsd*)			# NetBSD/mips, either endian.
 	target_cpu_default="MASK_ABICALLS"
 	tm_file="elfos.h ${tm_file} mips/elf.h ${nbsd_tm_file} mips/netbsd.h"
@@ -4986,6 +4997,10 @@ case "${target}" in
 			abi_pattern="lp64[dfs]"
 			abi_default="lp64d"
 			;;
+		loongarch64-*-haiku*)
+			abi_pattern="lp64[dfs]"
+			abi_default="lp64d"
+			;;
 		*)
 			echo "Unsupported target ${target}." 1>&2
 			exit 1
@@ -4999,6 +5014,7 @@ case "${target}" in
 		case ${target} in
 		  *-linux-gnu*)  triplet_os="linux-gnu";;
 		  *-linux-musl*) triplet_os="linux-musl";;
+		  *-haiku*) triplet_os="haiku";;
 		  *)
 			  echo "Unsupported target ${target}." 1>&2
 			  exit 1
diff --git a/gcc/config/loongarch/haiku.h b/gcc/config/loongarch/haiku.h
new file mode 100644
index 0000000..921864d
--- /dev/null
+++ b/gcc/config/loongarch/haiku.h
@@ -0,0 +1,52 @@
+/* Definitions for Loongarch Haiku systems with ELF format.
+   Copyright (C) 1998-2017 Free Software Foundation, Inc.
+
+This file is part of GCC.
+
+GCC is free software; you can redistribute it and/or modify
+it under the terms of the GNU General Public License as published by
+the Free Software Foundation; either version 3, or (at your option)
+any later version.
+
+GCC is distributed in the hope that it will be useful,
+but WITHOUT ANY WARRANTY; without even the implied warranty of
+MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the
+GNU General Public License for more details.
+
+You should have received a copy of the GNU General Public License
+along with GCC; see the file COPYING3.  If not see
+<http://www.gnu.org/licenses/>.  */
+
+#undef TARGET_OS_CPP_BUILTINS
+#define TARGET_OS_CPP_BUILTINS()		\
+  do									\
+    {									\
+      builtin_define ("__HAIKU__");					\
+      builtin_define ("__stdcall=__attribute__((__stdcall__))");	\
+      builtin_define ("__cdecl=__attribute__((__cdecl__))");		\
+      builtin_define ("__STDC_ISO_10646__=201103L"); \
+      builtin_assert ("system=haiku");					\
+    }									\
+  while (0)
+
+#define MUSL_ABI_SPEC \
+  "%{mabi=lp64d:}" \
+  "%{mabi=lp64f:-sp}" \
+  "%{mabi=lp64s:-sf}"
+
+/* SUBTARGET_CC1_SPEC is passed to the compiler proper.  It may be
+   overridden by subtargets.  */
+#ifndef SUBTARGET_CC1_SPEC
+#define SUBTARGET_CC1_SPEC ""
+#endif
+
+#undef LIB_SPEC
+// Linux adds -latomic from RISC-V only has word-sized atomics
+// Not sure if we really need it though.
+#define LIB_SPEC " -lroot "
+
+// riscv.h defines /lib and friends which breaks the sysroot
+#undef STARTFILE_PREFIX_SPEC
+
+#undef	LINK_SPEC
+#define LINK_SPEC "-melf" ABI_GRLEN_SPEC "loongarch" " %{!r:-shared} %{nostart:-e 0} %{shared:-e 0} %{!shared: %{!nostart: -no-undefined}} -X"
diff --git a/gcc/config/loongarch/t-haiku b/gcc/config/loongarch/t-haiku
new file mode 100644
index 0000000..146dbab
--- /dev/null
+++ b/gcc/config/loongarch/t-haiku
@@ -0,0 +1,4 @@
+# Disable for now, only loongarch64 on Haiku for the moment
+# Only XLEN and ABI affect multilib dir names, e.g. /lib32/ilp32d/
+#MULTILIB_DIRNAMES := $(patsubst loongarch32%,lib32,$(patsubst loongarch64%,lib64,$(MULTILIB_DIRNAMES)))
+#MULTILIB_OSDIRNAMES := $(patsubst lib%,../lib%,$(MULTILIB_DIRNAMES))
diff --git a/isl/config.sub b/isl/config.sub
index 1d8e98b..7c98612 100755
--- a/isl/config.sub
+++ b/isl/config.sub
@@ -265,6 +265,7 @@ case $basic_machine in
 	| k1om \
 	| le32 | le64 \
 	| lm32 \
+	| loongarch64 \
 	| m32c | m32r | m32rle | m68000 | m68k | m88k \
 	| maxq | mb | microblaze | microblazeel | mcore | mep | metag \
 	| mips | mipsbe | mipseb | mipsel | mipsle \
@@ -390,6 +391,7 @@ case $basic_machine in
 	| k1om-* \
 	| le32-* | le64-* \
 	| lm32-* \
+	| loongarch64-* \
 	| m32c-* | m32r-* | m32rle-* \
 	| m68000-* | m680[012346]0-* | m68360-* | m683?2-* | m68k-* \
 	| m88110-* | m88k-* | maxq-* | mcore-* | metag-* \
diff --git a/libgcc/config.host b/libgcc/config.host
index 648af2c..f3ec973 100644
--- a/libgcc/config.host
+++ b/libgcc/config.host
@@ -981,6 +981,15 @@ loongarch*-*-linux*)
 	esac
 	md_unwind_header=loongarch/linux-unwind.h
 	;;
+loongarch*-*-*)
+	extra_parts="$extra_parts crtfastmath.o"
+	tmake_file="${tmake_file} t-crtfm loongarch/t-crtstuff"
+	case ${host} in
+	  *)
+	    tmake_file="${tmake_file} t-slibgcc-libgcc"
+	    ;;
+	esac
+	;;
 m32r-*-elf*)
 	tmake_file="$tmake_file m32r/t-m32r t-fdpbit"
 	extra_parts="$extra_parts crtinit.o crtfini.o"
diff --git a/mpc/build-aux/config.sub b/mpc/build-aux/config.sub
index a3f11f8..7d54c2a 100755
--- a/mpc/build-aux/config.sub
+++ b/mpc/build-aux/config.sub
@@ -1183,6 +1183,7 @@ case $cpu-$vendor in
 			| k1om \
 			| le32 | le64 \
 			| lm32 \
+			| loongarch64 \
 			| m32c | m32r | m32rle \
 			| m5200 | m68000 | m680[012346]0 | m68360 | m683?2 | m68k \
 			| m6811 | m68hc11 | m6812 | m68hc12 | m68hcs12x \
-- 
2.43.0

